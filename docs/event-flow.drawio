<mxfile host="app.diagrams.net" type="device"><diagram id="event-flow" name="Event flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1260" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Event flow: deleteUser" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The synchronous part ends at COMMIT. Everything below the line happens asynchronously through the outbox and Kafka." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c4" value="web" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c5" value="graphql-gateway&#10;(Go)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c6" value="user-service&#10;gRPC handler (Go)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c7" value="user-db&#10;(Postgres)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c8" value="user-service&#10;outbox relay (Go)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c9" value="Kafka&#10;user.events" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c10" value="item-service&#10;consumer (Rust)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1300" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c11" value="item-db&#10;(Postgres)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1510" y="100" width="180" height="1000" as="geometry"/></mxCell><mxCell id="c12" value="mutation deleteUser(id)" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="200" as="sourcePoint"/><mxPoint x="340.0" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="gRPC DeleteUser{id}" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="250" as="sourcePoint"/><mxPoint x="550.0" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="one transaction" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550.0" y="300" as="sourcePoint"/><mxPoint x="760.0" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="BEGIN;&#10;DELETE FROM users WHERE id = $1;&#10;INSERT INTO outbox&#10;  (event_id, topic, aggregate_id, payload)&#10;  VALUES (…, 'user.events', $1, UserDeleted);&#10;COMMIT;" style="shape=note;size=12;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770.0" y="310" width="280" height="100" as="geometry"/></mxCell><mxCell id="c16" value="ok" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760.0" y="440" as="sourcePoint"/><mxPoint x="550.0" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="DeleteUserResponse" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550.0" y="480" as="sourcePoint"/><mxPoint x="340.0" y="480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="{ deleteUser: true }" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="520" as="sourcePoint"/><mxPoint x="130.0" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="asynchronous from here: the request has already been answered" style="endArrow=none;dashed=1;strokeColor=#999999;fontColor=#666666;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;align=left;labelPosition=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="560" as="sourcePoint"/><mxPoint x="1720" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="poll outbox" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970.0" y="620" as="sourcePoint"/><mxPoint x="760.0" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="SELECT … FROM outbox&#10;WHERE published_at IS NULL&#10;ORDER BY id&#10;FOR UPDATE SKIP LOCKED" style="shape=note;size=12;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980.0" y="580" width="190" height="70" as="geometry"/></mxCell><mxCell id="c22" value="pending rows" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760.0" y="670" as="sourcePoint"/><mxPoint x="970.0" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="produce key=user_id&#10;EventEnvelope{event_id, UserDeleted}" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970.0" y="720" as="sourcePoint"/><mxPoint x="1180.0" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="ack (acks=all)" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180.0" y="760" as="sourcePoint"/><mxPoint x="970.0" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="UPDATE outbox SET published_at = now()" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970.0" y="800" as="sourcePoint"/><mxPoint x="760.0" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="poll · group item-service" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180.0" y="870" as="sourcePoint"/><mxPoint x="1390.0" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="one transaction" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390.0" y="920" as="sourcePoint"/><mxPoint x="1600.0" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="BEGIN;&#10;INSERT INTO processed_events (event_id)&#10;  VALUES ($id) ON CONFLICT DO NOTHING;&#10;-- 0 rows inserted → duplicate: COMMIT, stop&#10;UPDATE items SET created_by = NULL&#10;  WHERE created_by = $user;&#10;DELETE FROM users_projection WHERE id = $user;&#10;COMMIT;" style="shape=note;size=12;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220.0" y="930" width="360" height="130" as="geometry"/></mxCell><mxCell id="c29" value="ok" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1600.0" y="1070" as="sourcePoint"/><mxPoint x="1390.0" y="1070" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="commit offset" style="html=0;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390.0" y="1090" as="sourcePoint"/><mxPoint x="1180.0" y="1090" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Guarantees&#10;• If the DELETE committed, the event will be published (outbox).&#10;• A crash between produce and UPDATE outbox re-publishes the event;&#10;  processed_events makes the consumer ignore the duplicate.&#10;• key = user_id → all events for one user land in one partition, in order." style="shape=note;size=12;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="560" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
