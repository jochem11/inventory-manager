<mxfile host="app.diagrams.net" type="device"><diagram id="overview" name="0 Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1210" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="overview-5" value="&lt;b&gt;deployment&lt;/b&gt; Development (Tilt)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=240;height=26;fillColor=none;strokeColor=#61385c;fontSize=13;align=left;spacingLeft=8;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1240" height="620" as="geometry"/></mxCell><mxCell id="overview-24" value="&lt;b&gt;Notation&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=120;height=26;fillColor=none;strokeColor=#61385c;fontSize=13;align=left;spacingLeft=8;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1240" height="420" as="geometry"/></mxCell><mxCell id="overview-3" value="&lt;b&gt;Inventory manager: authentication and events&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="26" as="geometry"/></mxCell><mxCell id="overview-4" value="UML 2.5 diagrams of how a login travels through the web app, the GraphQL gateway, the auth-service, the user-service and Kafka. One page per diagram; this page has the deployment and the notation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontColor=#6b5a69;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1100" height="36" as="geometry"/></mxCell><mxCell id="overview-6" value="«device»&lt;br&gt;&lt;b&gt;Developer machine&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;bou