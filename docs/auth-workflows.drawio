><mxCell id="overview-11" value="«component»&lt;br&gt;&lt;b&gt;graphql-gateway&lt;/b&gt;&lt;br&gt;:4000" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="230" width="220" height="70" as="geometry"/></mxCell><mxCell id="overview-12" value="«component»&lt;br&gt;&lt;b&gt;auth-service&lt;/b&gt;&lt;br&gt;:50052" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="390" width="220" height="70" as="geometry"/></mxCell><mxCell id="overview-13" value="«component»&lt;br&gt;&lt;b&gt;user-service&lt;/b&gt;&lt;br&gt;:50051" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="550" width="220" height="70" as="geometry"/></mxCell><mxCell id="overview-14" value="«component»&lt;br&gt;&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;auth.events, user.events" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="560" width="230" height="70" as="geometry"/></mxCell><mxCell id="overview-15" value="«component»&lt;br&gt;&lt;b&gt;Jaeger&lt;/b&gt;&lt;br&gt;:16686" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="230" width="230" height="70" as="geometry"/></mxCell><mxCell id="overview-26" value="&lt;b&gt;Synchronous message&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="779" width="230" height="22" as="geometry"/></mxCell><mxCell id="overview-27" value="A call that waits for its answer: GraphQL, gRPC, SQL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="779" width="760" height="40" as="geometry"/></mxCell><mxCell id="overview-29" value="&lt;b&gt;Asynchronous message&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="839" width="230" height="22" as="geometry"/></mxCell><mxCell id="overview-30" value="Fire and forget: publishing to and delivering from Kafka." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="839" width="760" height="40" as="geometry"/></mxCell><mxCell id="overview-32" value="&lt;b&gt;Reply message&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="899" width="230" height="22" as="geometry"/></mxCell><mxCell id="overview-33" value="The answer to a synchronous call, with its return value." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#20131f;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="899" width="760" height="40" as="geometry"/></mxCell><mxCell id="overview-34" value="" style="line;strokeWidth=1;direction=south;html=1;dashed=1;strokeColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="145" y="949" width="10" height="46" as="geometry"/></mxCell><mxCell id="overview-35" value="" style="html=1;fillColor=#ffffff;strokeColor=#20131f;fontFamily=Helvetica;" vertex="1" pa