<mxfile host="app.diagrams.net" type="device"><diagram id="graphql-api" name="GraphQL API"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="940" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="GraphQL API: paging, sorting and filtering through every layer" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Offset pagination with totalCount, matching the DataTable's numbered pages. Each layer only translates; the query logic lives in the owning service." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c4" value="1 · DataTableQuery (web, TypeScript)" style="swimlane;startSize=30;fontStyle=1;fontSize=12;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="420" as="geometry"/></mxCell><mxCell id="c5" value='{&#10;  page: 2,&#10;  pageSize: 25,&#10;  sort: { id: "quantity", direction: "desc" },&#10;  search: "cable",&#10;  filters: {&#10;    category: "electrical",&#10;    quantity: "&gt;=5",&#10;    alert: "true"&#10;  }&#10;}&#10;&#10;Column filter text for quantity is parsed:&#10;  "5"    → { eq: 5 }&#10;  "&gt;=5"  → { gte: 5 }&#10;  "&lt;=5"  → { lte: 5 }&#10;  "1-10" → { gte: 1, lte: 10 }' style="text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;" vertex="1" parent="c4"><mxGeometry x="0" y="30" width="420" height="390" as="geometry"/></mxCell><mxCell id="c6" value="2 · GraphQL request (web → gateway)" style="swimlane;startSize=30;fontStyle=1;fontSize=12;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="420" height="420" as="geometry"/></mxCell><mxCell id="c7" value='query Items($offset: Int!, $limit: Int!,&#10;            $orderBy: ItemOrder,&#10;            $filter: ItemFilter) {&#10;  items(offset: $offset, limit: $limit,&#10;        orderBy: $orderBy, filter: $filter) {&#10;    totalCount&#10;    nodes { id name quantity category&#10;            notes lowStockAlert }&#10;  }&#10;}&#10;&#10;variables:&#10;{&#10;  "offset": 50,&#10;  "limit": 25,&#10;  "orderBy": { "field": "QUANTITY",&#10;               "direction": "DESC" },&#10;  "filter": { "search": "cable",&#10;              "category": "electrical",&#10;              "quantity": { "gte": 5 },&#10;              "lowStockAlert": true }&#10;}' style="text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;" vertex="1" parent="c6"><mxGeometry x="0" y="30" width="420" height="390" as="geometry"/></mxCell><mxCell id="c8" value="3 · proto ListItemsRequest (gateway → item-service)" style="swimlane;startSize=30;fontStyle=1;fontSize=12;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="420" height="420" as="geometry"/></mxCell><mxCell id="c9" value='ListItemsRequest {&#10;  offset: 50&#10;  limit: 25&#10;  order_by {&#10;    field:     ITEM_SORT_FIELD_QUANTITY&#10;    direction: SORT_DIRECTION_DESC&#10;  }&#10;  filter {&#10;    search:          "cable"&#10;    category:        "electrical"&#10;    quantity         { gte: 5 }&#10;    low_stock_alert: true&#10;  }&#10;}&#10;&#10;Unset filter fields are proto3 `optional`&#10;and simply absent: no condition.' style="text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;" vertex="1" parent="c8"><mxGeometry x="0" y="30" width="420" height="390" as="geometry"/></mxCell><mxCell id="c10" value="4 · SQL (item-service → item-db)" style="swimlane;startSize=30;fontStyle=1;fontSize=12;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1480" y="110" width="420" height="420" as="geometry"/></mxCell><mxCell id="c11" value="SELECT id, name, quantity, category, notes,&#10;       low_stock_alert, created_by,&#10;       created_at, updated_at,&#10;       COUNT(*) OVER () AS total_count&#10;FROM items&#10;WHERE (name ILIKE $1 OR notes ILIKE $1&#10;       OR category ILIKE $1)   -- search&#10;  AND category = $2&#10;  AND quantity &gt;= $3&#10;  AND low_stock_alert = $4&#10;ORDER BY quantity DESC, id ASC&#10;LIMIT 25 OFFSET 50;&#10;&#10;-- $1 = '%cable%'  (%, _ and \ escaped)&#10;-- ORDER BY column picked from a&#10;--   fixed enum → column map, never&#10;--   from user text" style="text;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;" vertex="1" parent="c10"><mxGeometry x="0" y="30" width="420" height="390" as="geometry"/></mxCell><mxCell id="c12" value="toItemsVariables()&#10;api/items.ts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="resolver:&#10;validate + map" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="repository:&#10;build query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="Response path" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="400" height="20" as="geometry"/></mxCell><mxCell id="c16" value="25 rows, each with total_count = 137&#10;(page past the end → 0 rows: run a&#10; separate COUNT(*) so the total stays right)" style="rounded=1;whiteSpace=wrap;arcSize=8;fontSize=12;align=left;spacingLeft=8;fontSize=10;fontFamily=Courier New;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1480" y="580" width="420" height="70" as="geometry"/></mxCell><mxCell id="c17" value="ListItemsResponse {&#10;  items: [25 × Item], total_count: 137 }" style="rounded=1;whiteSpace=wrap;arcSize=8;fontSize=12;align=left;spacingLeft=8;fontSize=10;fontFamily=Courier New;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1000" y="580" width="420" height="70" as="geometry"/></mxCell><mxCell id="c18" value='{ "data": { "items": {&#10;    "totalCount": 137, "nodes": [ …25 ] } } }' style="rounded=1;whiteSpace=wrap;arcSize=8;fontSize=12;align=left;spacingLeft=8;fontSize=10;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="580" width="420" height="70" as="geometry"/></mxCell><mxCell id="c19" value='{ rows: nodes, total: totalCount }&#10;→ pager shows "51–75 of 137"' style="rounded=1;whiteSpace=wrap;arcSize=8;fontSize=12;align=left;spacingLeft=8;fontSize=10;fontFamily=Courier New;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="420" height="70" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#666666;strokeWidth=1;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="Sort mapping (whitelist)" style="swimlane;fontStyle=1;startSize=28;horizontal=1;collapsible=0;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;marginBottom=0;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="420" height="204" as="geometry"/></mxCell><mxCell id="c24" value="ItemSortField     → SQL column" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="28" width="420" height="22" as="geometry"/></mxCell><mxCell id="c25" value="NAME              → name" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c26" value="QUANTITY          → quantity" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="72" width="420" height="22" as="geometry"/></mxCell><mxCell id="c27" value="CATEGORY          → category" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="94" width="420" height="22" as="geometry"/></mxCell><mxCell id="c28" value="NOTES             → notes NULLS LAST" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="116" width="420" height="22" as="geometry"/></mxCell><mxCell id="c29" value="LOW_STOCK_ALERT   → low_stock_alert" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="138" width="420" height="22" as="geometry"/></mxCell><mxCell id="c30" value="(no orderBy)      → name ASC" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="160" width="420" height="22" as="geometry"/></mxCell><mxCell id="c31" value="always appended   → , id ASC" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c23"><mxGeometry x="0" y="182" width="420" height="22" as="geometry"/></mxCell><mxCell id="c32" value="Filter mapping (all conditions AND-ed)" style="swimlane;fontStyle=1;startSize=28;horizontal=1;collapsible=0;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;marginBottom=0;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="710" width="420" height="204" as="geometry"/></mxCell><mxCell id="c33" value="search         name/notes/category ILIKE" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="28" width="420" height="22" as="geometry"/></mxCell><mxCell id="c34" value="name           name ILIKE '%v%'" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c35" value="category       category = v" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="72" width="420" height="22" as="geometry"/></mxCell><mxCell id="c36" value="quantity.eq    quantity = v" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="94" width="420" height="22" as="geometry"/></mxCell><mxCell id="c37" value="quantity.gte   quantity &gt;= v" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="116" width="420" height="22" as="geometry"/></mxCell><mxCell id="c38" value="quantity.lte   quantity &lt;= v" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="138" width="420" height="22" as="geometry"/></mxCell><mxCell id="c39" value="notes          notes ILIKE '%v%'" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="160" width="420" height="22" as="geometry"/></mxCell><mxCell id="c40" value="lowStockAlert  low_stock_alert = v" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c32"><mxGeometry x="0" y="182" width="420" height="22" as="geometry"/></mxCell><mxCell id="c41" value="Limits and errors (extensions.code)" style="swimlane;fontStyle=1;startSize=28;horizontal=1;collapsible=0;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;marginBottom=0;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="710" width="420" height="182" as="geometry"/></mxCell><mxCell id="c42" value="limit 1..100 (default 25)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c41"><mxGeometry x="0" y="28" width="420" height="22" as="geometry"/></mxCell><mxCell id="c43" value="offset ≥ 0 (default 0)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c41"><mxGeometry x="0" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c44" value="out of range      → BAD_USER_INPUT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c41"><mxGeometry x="0" y="72" width="420" height="22" as="geometry"/></mxCell><mxCell id="c45" value="INVALID_ARGUMENT  → BAD_USER_INPUT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c41"><mxGeometry x="0" y="94" width="420" height="22" as="geometry"/></mxCell><mxCell id="c46" value="NOT_FOUND         → NOT_FOUND" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c41"><mxGeometry x="0" y="116" width="420" height="22" as="geometry"/></mxCell><mxCell id="c47" value="anything else     → INTERNAL" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c41"><mxGeometry x="0" y="138" width="420" height="22" as="geometry"/></mxCell><mxCell id="c48" value="  (details logged, not returned)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c41"><mxGeometry x="0" y="160" width="420" height="22" as="geometry"/></mxCell><mxCell id="c49" value="Same convention for every list" style="swimlane;fontStyle=1;startSize=28;horizontal=1;collapsible=0;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;marginBottom=0;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="710" width="420" height="204" as="geometry"/></mxCell><mxCell id="c50" value="items(offset, limit, orderBy: ItemOrder," style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="28" width="420" height="22" as="geometry"/></mxCell><mxCell id="c51" value="      filter: ItemFilter): ItemConnection!" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c52" value="users(offset, limit, orderBy: UserOrder," style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="72" width="420" height="22" as="geometry"/></mxCell><mxCell id="c53" value="      filter: UserFilter): UserConnection!" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="94" width="420" height="22" as="geometry"/></mxCell><mxCell id="c54" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="116" width="420" height="22" as="geometry"/></mxCell><mxCell id="c55" value="type XConnection {" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="138" width="420" height="22" as="geometry"/></mxCell><mxCell id="c56" value="  totalCount: Int!" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="160" width="420" height="22" as="geometry"/></mxCell><mxCell id="c57" value="  nodes: [X!]! }" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c49"><mxGeometry x="0" y="182" width="420" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
