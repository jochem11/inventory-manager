<mxfile host="app.diagrams.net" type="device"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Inventory manager: architecture" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="GraphQL at the edge, gRPC from gateway to services, Kafka between services, one Postgres per service." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Kubernetes cluster (Tilt · infra/development)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1120" height="760" as="geometry"/></mxCell><mxCell id="c5" value="Browser" style="rounded=1;whiteSpace=wrap;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="200" height="50" as="geometry"/></mxCell><mxCell id="c6" value="web&#10;SolidStart · TypeScript&#10;:3000" style="rounded=1;whiteSpace=wrap;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="210" width="240" height="70" as="geometry"/></mxCell><mxCell id="c7" value="graphql-gateway&#10;Go · gqlgen + net/http + grpc-go&#10;:4000  (no DB, no Kafka)" style="rounded=1;whiteSpace=wrap;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="350" width="280" height="80" 