etry"/></mxCell><mxCell id="c15" value="proto/  (shared contract)&#10;&#10;• item/v1, user/v1: gRPC services&#10;• */v1/events.proto: event envelopes&#10;• each language generates its own stubs&#10;  (tonic-build for Rust, buf for Go)" style="shape=note;size=12;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="770" width="300" height="130" as="geometry"/></mxCell><mxCell id="c16" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="HTTP POST /graphql&#10;(server-side, GATEWAY_URL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="gRPC ItemService" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="gRPC UserService" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#82b366;