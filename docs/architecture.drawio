Cell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="995" as="sourcePoint"/><mxPoint x="110" y="995" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="HTTP / GraphQL" style="text;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="125" y="985" width="400" height="20" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1023" as="sourcePoint"/><mxPoint x="110" y="1023" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="gRPC (sync, gateway → service only)" style="text;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="125" y="1013" width="400" height="20" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1051" as="sourcePoint"/><mxPoint x="110" y="1051" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="Kafka event (async, service ↔ service only)" style="text;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="125" y="1041" width="400" height="20" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1079" as="sourcePoint"/><mxPoint x="110" y="1079" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="SQL (a service only touches its own DB)" style="text;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="125" y="1069" width="400" height="20" as="geometry"/></mxCell><mxCell id="c35" value="Rules&#10;• Services never call each other and never read another service's DB.&#10;• Data a service needs from another service arrives as events and is kept&#10;  in a local projection (e.g. item-db.users_projection).&#10;• Events are written to an outbox table in the same transaction as the&#10;  change, then published by a relay (at-least-once, consumers dedupe)." style="shape=note;size=12;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="960" width="600" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
