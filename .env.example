# Local settings and credentials. Copy this file to .env and fill it in:
#
#   cp .env.example .env
#
# .env is never committed. Tilt loads it into the cluster as the Secret
# `app-secrets`; `make run` and `make test` in services/* read it too.

# --- MySQL (runs on your machine; each service creates its own database) ----
DB_USER=root
DB_PASSWORD=

# --- auth-service --------------------------------------------------------------
# Accounts (comma-separated emails) that get the admin role at every start.
# Register the account first, then restart the auth-service.
ADMIN_EMAILS=

# Ed25519 key that signs access tokens, as one line with \n for the line breaks.
# Empty: a new key at every start, which logs everyone out on each restart.
# Generate one with:
#   openssl genpkey -algorithm ed25519 | awk 'NF {printf "%s\\n", $0}'
JWT_PRIVATE_KEY=
