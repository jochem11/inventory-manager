etica;" vertex="1" parent="1"><mxGeometry x="516" y="479" width="388" height="16" as="geometry"/></mxCell><mxCell id="delete-user-20" value="The auth-service consumes UserDeleted&lt;br&gt;and removes the login and its sessions." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fbf6dc;strokeColor=#6b5a69;fontSize=10;fontColor=#20131f;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="618" y="634" width="276" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="data-model" name="Data model"><mxGraphModel dx="940" dy="290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="290" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="data-model-3" value="«table users»&lt;br&gt;&lt;b&gt;User&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="270" height="166" as="geometry"/></mxCell><mxCell id="data-model-5" value="«table outbox»&lt;br&gt;&lt;b&gt;OutboxMessage&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="270" height="166" as="geometry"/></mxCell><mxCell id="data-model-7" value="«table processed_events»&lt;br&gt;&lt;b&gt;ProcessedEvent&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="250" height="82" as="geometry"/></mxCell><mxCell id="data-model-4" value="id: char(27)  «KSUID, primary key»&lt;br&gt;first_name: varchar(100)&lt;br&gt;last_name: varchar(100)&lt;br&gt;email: varchar(255)  «unique»&lt;br&gt;phone: varchar(32)  [0..1]  E.164&lt;br&gt;avatar_url: varchar(2048)  [0..1]&lt;br&gt;created_at, updated_at: datetime&lt;br&gt;deleted_at: datetime  [0..1]  «soft delete»" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-3"><mxGeometry x="0" y="40" width="270" height="126" as="geometry"/></mxCell><mxCell id="data-model-6" value="id: bigint  «auto increment»&lt;br&gt;event_id: char(27)  «unique»&lt;br&gt;topic: varchar&lt;br&gt;key: varchar  (the user id)&lt;br&gt;payload: mediumblob  (protobuf)&lt;br&gt;headers: json  (trace context)&lt;br&gt;created_at: datetime&lt;br&gt;published_at: datetime  [0..1]" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-5"><mxGeometry x="0" y="40" width="270" height="126" as="geometry"/></mxCell><mxCell id="data-model-8" value="event_id: char(27)  «primary key»&lt;br&gt;processed_at: datetime" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-7"><mxGeometry x="0" y="40" width="250" height="42" as="geometry"/></mxCell><mxCell id="data-model-1" value="&lt;b&gt;Data model: database user_service&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="379" height="26" as="geometry"/></mxCell><mxCell id="data-model-2" value="outbox and processed_events come from shared/kafka and exist in every service that uses Kafka." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="670" height="20" as="geometry"/></mxCell><mxCell id="data-model-9" value="Published outbox rows are deleted after 7 days. A User row&#x27;s id is the same id as the identity in the auth-service." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="200" width="260" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
