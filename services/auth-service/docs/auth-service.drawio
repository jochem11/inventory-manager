)" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="91" y="148" as="sourcePoint"/><mxPoint x="241" y="148" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-4" value="BEGIN; SELECT sessions WHERE&lt;br&gt;refresh_token_hash = SHA-256(token)" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="193" as="sourcePoint"/><mxPoint x="385" y="193" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-5" value="UNAUTHENTICATED" style="html=1;endArrow=open;endSize=8;dashed=1;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="257" as="sourcePoint"/><mxPoint x="91" y="257" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-6" value="UPDATE sessions SET refresh_token_hash = SHA-256(new token)" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="321" as="sourcePoint"/><mxPoint x="385" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-7" value="Issue(…) with current roles + permissions" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="353" as="sourcePoint"/><mxPoint x="529" y="353" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-8" value="COMMIT" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="385" as="sourcePoint"/><mxPoint x="385" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-9" value="Tokens{new access token, new refresh token}" style="html=1;endArrow=open;endSize=8;dashed=1;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="417" as="sourcePoint"/><mxPoint x="91" y="417" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-14" value="Logout(refresh token)" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="91" y="469" as="sourcePoint"/><mxPoint x="241" y="469" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-15" value="UPDATE sessions SET revoked_at = now()" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="501" as="sourcePoint"/><mxPoint x="385" y="501" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-16" value="OK (also when the session was already gone)" style="html=1;endArrow=open;endSize=8;dashed=1;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="533" as="sourcePoint"/><mxPoint x="91" y="533" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-17" value="GetPublicKeys()" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="91" y="569" as="sourcePoint"/><mxPoint x="241" y="569" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-18" value="[{kid, Ed25519 public key}]: the gateway verifies JWTs with it" style="html=1;endArrow=open;endSize=8;dashed=1;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="241" y="601" as="sourcePoint"/><mxPoint x="91" y="601" as="targetPoint"/></mxGeometry></mxCell><mxCell id="refresh-logout-1" value="&lt;b&gt;Refresh (rotation) and Logout&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="335" height="26" as="geometry"/></mxCell><mxCell id="refresh-logout-2" value="Every refresh replaces the refresh token: a stolen, already-used token stops working." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="608" height="20" as="geometry"/></mxCell><mxCell id="refresh-logout-11" value="[not found, revoked or expired]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#61385c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="67" y="213" width="532" height="16" as="geometry"/></mxCell><mxCell id="refresh-logout-13" value="[active]" styl