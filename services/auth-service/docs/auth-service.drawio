"435" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="user-deleted-7" value="COMMIT (no identity: fine, e.g. made by createUser)" style="html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="272" y="353" as="sourcePoint"/><mxPoint x="435" y="353" as="targetPoint"/></mxGeometry></mxCell><mxCell id="user-deleted-12" value="commit offset" style="html=1;endArrow=open;endFill=0;endSize=10;rounded=0;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="272" y="395" as="sourcePoint"/><mxPoint x="97" y="395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="user-deleted-1" value="&lt;b&gt;When a user is deleted&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="258" height="26" as="geometry"/></mxCell><mxCell id="user-deleted-2" value="The user-service publishes UserDeleted; this consumer removes the login." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="517" height="20" as="geometry"/></mxCell><mxCell id="user-deleted-9" value="[redelivery]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#61385c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="73" y="200" width="431" height="16" as="geometry"/></mxCell><mxCell id="user-deleted-11" value="[first delivery]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#61385c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="29" y="271" width="475" height="16" as="geometry"/></mxCell><mxCell id="user-deleted-13" value="Without sessions, the next refresh fails: the user is logged out&lt;br&gt;within 15 minutes, when the current access token expires." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fbf6dc;strokeColor=#6b5a69;fontSize=10;fontColor=#20131f;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="153" y="419" width="401" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="data-model" name="Data model"><mxGraphModel dx="990" dy="498" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="990" pageHeight="498" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="data-model-3" value="«table identities»&lt;br&gt;&lt;b&gt;Identity&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="280" height="138" as="geometry"/></mxCell><mxCell id="data-model-5" value="«table sessions»&lt;br&gt;&lt;b&gt;Session&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="260" height="138" as="geometry"/></mxCell><mxCell id="data-model-7" value="«table identity_tokens»&lt;br&gt;&lt;b&gt;IdentityToken&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="280" height="138" as="geometry"/></mxCell><mxCell id="data-model-9" value="«table roles»&lt;br&gt;&lt;b&gt;Role&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="200" height="82" as="geometry"/></mxCell><mxCell id="data-model-11" value="«table permissions»&lt;br&gt;&lt;b&gt;Permission&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#f5f0f4;strokeColor=#20131f;fontSize=11;fontColor=#20131f;collapsible=0;horizontal=1;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="200" height="96" as="geometry"/></mxCell><mxCell id="data-model-4" value="id: char(27)&lt;br&gt;user_id: char(27)  «unique», = profile id&lt;br&gt;email: varchar(255)  «unique»&lt;br&gt;password_hash: varchar(255)  (bcrypt)&lt;br&gt;email_verified_at: datetime  [0..1]&lt;br&gt;created_at, updated_at, deleted_at" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-3"><mxGeometry x="0" y="40" width="280" height="98" as="geometry"/></mxCell><mxCell id="data-model-6" value="id: char(27)&lt;br&gt;identity_id: char(27)&lt;br&gt;refresh_token_hash: binary(32)  «unique»&lt;br&gt;expires_at: datetime  (30 d)&lt;br&gt;revoked_at: datetime  [0..1]&lt;br&gt;created_at, updated_at" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-5"><mxGeometry x="0" y="40" width="260" height="98" as="geometry"/></mxCell><mxCell id="data-model-8" value="id: char(27)&lt;br&gt;identity_id: char(27)&lt;br&gt;purpose: varchar(32)  (verify_email)&lt;br&gt;email: varchar(255)  (address it was sent to)&lt;br&gt;token_hash: binary(32)  «unique»&lt;br&gt;expires_at (24 h), used_at [0..1], created_at" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-7"><mxGeometry x="0" y="40" width="280" height="98" as="geometry"/></mxCell><mxCell id="data-model-10" value="id: char(27)&lt;br&gt;name: varchar(64)  «unique»" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-9"><mxGeometry x="0" y="40" width="200" height="42" as="geometry"/></mxCell><mxCell id="data-model-12" value="id: char(27)&lt;br&gt;name: varchar(128)  «unique»&lt;br&gt;e.g. users:read, items:write" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#20131f;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="data-model-11"><mxGeometry x="0" y="40" width="200" height="56" as="geometry"/></mxCell><mxCell id="data-model-13" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="data-model-3" target="data-model-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="data-model-16" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;" edge="1" parent="1" source="data-model-3" target="data-model-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="data-model-19" value="identity_roles" style="html=1;rounded=0;endArrow=none;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="data-model-3" target="data-model-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="data-model-22" value="role_permissions" style="html=1;rounded=0;endArrow=none;fontSize=10;strokeColor=#20131f;fontColor=#20131f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="data-model-9" target="data-model-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="data-model-1" value="&lt;b&gt;Data model: database auth_service&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#20131f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="379" height="26" as="geometry"/></mxCell><mxCell id="data-model-2" value="outbox and processed_events (from shared/kafka) are left out; see the user-service data model." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#6b5a69;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="670" height="20" as="geometry"/></mxCell><mxCell id="data-model-14" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#20131f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" connectable="0" parent="data-model-13"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="data-model-15" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#20131f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" connectable="0" parent="data-model-13"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="data-model-17" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#20131f;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" connectable="0" parent="data-model-16"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="data-model-18" value="*" style="edge